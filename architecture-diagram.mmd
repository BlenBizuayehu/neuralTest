graph TB
    subgraph "Frontend Layer (React)"
        App[App.jsx<br/>Main Application<br/>State Management]
        Terminal[Terminal Component<br/>Command Interface<br/>Real-time Output]
        AIPanel[AIPanel Component<br/>AI Chat Interface<br/>NL Processing]
        WorkflowRunner[WorkflowRunner Component<br/>Workflow Management<br/>Multi-step Execution]
        HistorySidebar[HistorySidebar Component<br/>Command History<br/>Session Management]
        Auth[Auth Components<br/>Login/Register<br/>User Management]
        LearningPanel[LearningModePanel<br/>Command Explanations<br/>Educational Content]
        SecurityModal[SecurityWarningModal<br/>Security Warnings<br/>Danger Alerts]
    end

    subgraph "Tauri IPC Bridge"
        IPC[Tauri IPC<br/>Frontend ↔ Backend<br/>Event-based Communication]
    end

    subgraph "Backend Layer (Rust)"
        Commands[commands.rs<br/>Command Handlers<br/>• Authentication<br/>• NL to Command<br/>• Command Execution<br/>• AI Features<br/>• Workflows<br/>• History Management]
        
        subgraph "Core Modules"
            AI[ai.rs<br/>AI Integration<br/>• OpenAI API Client<br/>• Gemini API Client<br/>• Groq API Client<br/>• NL Processing<br/>• Error Analysis<br/>• Context Building]
            Runner[runner.rs<br/>Command Execution<br/>• Process Management<br/>• Stream Handling<br/>• Output Capture<br/>• Process Killing<br/>• Async Execution]
            Context[context.rs<br/>Project Detection<br/>• Project Type Detection<br/>• Package Detection<br/>• Script Extraction<br/>• Git Detection<br/>• Metadata Extraction]
            Workflow[workflow.rs<br/>Workflow Engine<br/>• Step Execution<br/>• Error Handling<br/>• Progress Tracking<br/>• Workflow Generation]
            Redaction[redaction.rs<br/>Security Layer<br/>• Secret Redaction<br/>• Command Validation<br/>• Danger Detection<br/>• Interactive Command Check]
        end
        
        Models[models.rs<br/>Data Structures<br/>• CommandHistory<br/>• Workflow<br/>• Context<br/>• AI Responses<br/>• User Models]
        DBModule[db.rs<br/>Database Layer<br/>• Connection Management<br/>• CRUD Operations<br/>• Query Building]
    end

    subgraph "Data Layer"
        DB[(SQLite Database<br/>neural.db<br/>Local Storage)]
        Tables[Database Tables<br/>• commands_history<br/>• ai_suggestions<br/>• workflows<br/>• preferences<br/>• users]
    end

    subgraph "External Services"
        OpenAI[OpenAI API<br/>GPT-3.5/4 Models<br/>Chat Completions]
        Gemini[Google Gemini API<br/>Gemini Pro Models<br/>Free Tier Available]
        Groq[Groq API<br/>Fast Inference<br/>Low Latency]
    end

    subgraph "System Integration"
        Shell[OS Shell<br/>PowerShell/Bash/Zsh<br/>Command Execution]
        FileSystem[File System<br/>Project Files<br/>Directory Scanning]
    end

    %% Frontend component hierarchy
    App --> Terminal
    App --> AIPanel
    App --> WorkflowRunner
    App --> HistorySidebar
    App --> Auth
    Terminal --> LearningPanel
    Terminal --> SecurityModal

    %% Frontend to IPC communication
    Terminal -->|invoke| IPC
    AIPanel -->|invoke| IPC
    WorkflowRunner -->|invoke| IPC
    HistorySidebar -->|invoke| IPC
    Auth -->|invoke| IPC
    Terminal -->|listen| IPC
    AIPanel -->|listen| IPC
    WorkflowRunner -->|listen| IPC

    %% IPC to Backend routing
    IPC -->|route| Commands

    %% Backend module dependencies
    Commands -->|uses| AI
    Commands -->|uses| Runner
    Commands -->|uses| Context
    Commands -->|uses| Workflow
    Commands -->|uses| Redaction
    Commands -->|uses| Models
    Commands -->|uses| DBModule

    %% Module interactions
    AI -->|uses| Models
    Runner -->|uses| Models
    Context -->|uses| Models
    Workflow -->|uses| Models
    Workflow -->|uses| Runner
    Redaction -->|uses| Models
    DBModule -->|uses| Models

    %% Database connections
    Commands -->|queries| DBModule
    DBModule -->|connects| DB
    DB -->|stores| Tables

    %% External service connections
    AI -->|HTTP| OpenAI
    AI -->|HTTP| Gemini
    AI -->|HTTP| Groq

    %% System integration
    Runner -->|spawns| Shell
    Context -->|reads| FileSystem
    Workflow -->|executes via| Runner

    %% Styling
    classDef frontend fill:#4a9eff,stroke:#2d5aa0,stroke-width:2px,color:#fff
    classDef backend fill:#ce9178,stroke:#8b6f47,stroke-width:2px,color:#fff
    classDef database fill:#89d185,stroke:#4a7c59,stroke-width:2px,color:#fff
    classDef external fill:#ff6b6b,stroke:#c92a2a,stroke-width:2px,color:#fff
    classDef system fill:#a78bfa,stroke:#6b21a8,stroke-width:2px,color:#fff
    classDef bridge fill:#d4a574,stroke:#8b6914,stroke-width:2px,color:#fff

    class App,Terminal,AIPanel,WorkflowRunner,HistorySidebar,Auth,LearningPanel,SecurityModal frontend
    class Commands,AI,Runner,Context,Workflow,Redaction,Models,DBModule backend
    class DB,Tables database
    class OpenAI,Gemini,Groq external
    class Shell,FileSystem system
    class IPC bridge
